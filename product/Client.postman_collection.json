{
  "info": {
    "name": "Client API",
    "description": "CRUD de clientes — base URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": ["{{baseUrl}}"],
          "path": ["clients"]
        }
      }
    },
    {
      "name": "Buscar cliente por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clients/{{clientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["clients", "{{clientId}}"]
        }
      }
    },
    {
      "name": "Criar cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    if (json.id) {",
              "        pm.collectionVariables.set('clientId', json.id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva\",\n  \"age\": 28,\n  \"email\": \"mariasilva@gmail.com\",\n  \"phone\": \"11940028925\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": ["{{baseUrl}}"],
          "path": ["clients"]
        }
      }
    },
    {
      "name": "Atualizar cliente",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva Atualizada\",\n  \"age\": 29,\n  \"email\": \"mariasilva.nova@gmail.com\",\n  \"phone\": \"11940028926\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clients/{{clientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["clients", "{{clientId}}"]
        }
      }
    },
    {
      "name": "Excluir cliente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clients/{{clientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["clients", "{{clientId}}"]
        }
      }
    }
  ]
}
